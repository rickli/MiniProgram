<view class="page-bg">
  <view class="diary-card">
    <!-- 顶部沉浸式区域 -->
    <view class="diary-header">
      <view class="header-content">
        <text class="header-time">{{record.time}}</text>
        <view class="header-loc-wrap">
          <text class="header-loc">{{record.address || '正在获取地址...'}}</text>
        </view>
      </view>
    </view>

    <!-- 主体内容区 -->
    <view class="card-body">
      <!-- 心情选择 -->
      <view class="section">
        <view class="section-title">此刻心情</view>
        <view class="mood-selector">
          <view 
            wx:for="{{moods}}" 
            wx:key="index" 
            class="mood-opt {{selectedMood === item ? 'active' : ''}}" 
            bindtap="selectMood" 
            data-mood="{{item}}"
          >
            {{item}}
          </view>
        </view>
      </view>

      <!-- 文字笔记 -->
      <view class="section">
        <view class="section-title">笔记内容</view>
        <textarea 
          class="diary-input" 
          placeholder="记录这一刻的想法..." 
          placeholder-class="input-placeholder"
          bindinput="onNoteInput"
          maxlength="500"
        ></textarea>
      </view>

      <!-- 图片上传 -->
      <view class="section">
        <view class="section-title">添加照片 (最多3张)</view>
        <view class="polaroid-gallery">
          <view class="polaroid-item" wx:for="{{photos}}" wx:key="*this">
            <image src="{{item}}" mode="aspectFill" bindtap="previewImage" data-url="{{item}}"></image>
            <view class="delete-tag" bindtap="deletePhoto" data-index="{{index}}">×</view>
          </view>
          <view class="photo-add-btn" bindtap="chooseImage" wx:if="{{photos.length < 3}}">+</view>
        </view>
      </view>

      <!-- 标签系统 -->
      <view class="section">
        <view class="section-title">标签</view>
        <view class="diary-tags">
          <view 
            wx:for="{{presetTags}}" 
            wx:key="*this"
            class="diary-tag {{selectedTags.includes(item) ? 'active' : ''}}"
            bindtap="toggleTag"
            data-tag="{{item}}"
          >
            #{{item}}
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="diary-footer">
    <view class="save-pill-btn" bindtap="handleSave">珍藏这一页</view>
  </view>
</view>
