.container {
  padding: 30rpx;
  background: #f8f8f8;
  min-height: 100vh;
}

.section {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
}

.info-item {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.label {
  font-size: 28rpx;
  color: #666;
  width: 120rpx;
}

.value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.footer {
  margin-top: 40rpx;
}

.save-btn {
  width: 100%;
}

.section-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}
.mood-list {
  display: flex;
  justify-content: space-between;
}
.mood-item {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  border: 4rpx solid transparent;
  border-radius: 50%; /* 确保是圆形 */
  transition: all 0.3s;
}
.mood-item.active {
  border-color: #07c160;
}
