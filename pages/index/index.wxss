/* pages/index/index.wxss */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.header {
  margin-bottom: 120rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.main {
  width: 100%;
  display: flex;
  justify-content: center;
}

.punch-btn {
  width: 300rpx !important;
  height: 300rpx !important;
  border-radius: 50% !important;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  box-shadow: 0 10rpx 30rpx rgba(7, 193, 96, 0.3);
}

.footer {
  margin-top: 80rpx;
}

.last-tip {
  font-size: 28rpx;
  color: #999;
}
